# Copy to .env for the web deployment. Replace every placeholder before use.
MG_PLATFORM_DB_PASSWORD=replace-with-a-long-random-database-password
MG_OIDC_AUTHORITY=https://identity.example.com/realms/mg
MG_OIDC_AUDIENCE=mg-platform-api

# Optional self-hosted HashiCorp Vault KV v2 secret store (required before tenant provisioning).
MG_VAULT_ADDRESS=
MG_VAULT_TOKEN=
MG_VAULT_MOUNT=secret

# Optional isolated provisioning agent (mTLS). Mount the PFX read-only into the API container.
MG_PROVISIONING_AGENT_ADDRESS=
MG_PROVISIONING_AGENT_CLIENT_CERTIFICATE_PATH=/run/secrets/mg-provisioning-agent-client.pfx
MG_PROVISIONING_AGENT_CLIENT_CERTIFICATE_PASSWORD=

# Keep disabled until the separately deployed agent and its restricted PostgreSQL role are ready.
MG_PROVISIONING_WORKER_ENABLED=false
MG_PROVISIONING_WORKER_ID=
