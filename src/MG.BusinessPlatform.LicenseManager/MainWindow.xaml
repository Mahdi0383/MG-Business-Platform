<Window x:Class="MG.BusinessPlatform.LicenseManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مدیریت لایسنس MG Business Platform"
        Width="1000" Height="820" MinWidth="860" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F1F5F9">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#0F172A" Padding="20">
            <StackPanel>
                <TextBlock Text="مدیریت لایسنس MG Business Platform" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="صدور و بررسی لایسنس آفلاین؛ کلید خصوصی را محرمانه و خارج از رایانه مشتری نگه دارید." Foreground="#CBD5E1" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18">
                <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="۱. کلید امضای ناشر" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="کلید عمومی مورد اعتماد داخل برنامه تثبیت شده است. فقط کلید خصوصی متناظر با همین کلید برای صدور لایسنس پذیرفته می‌شود. کلید خصوصی را آفلاین و محرمانه نگه دارید؛ هرگز آن را در برنامه مشتری یا مخزن کد قرار ندهید." TextWrapping="Wrap" Foreground="#475569"/>
                        <TextBlock Text="مسیر کلید خصوصی مورد اعتماد"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Content="انتخاب…" Click="BrowsePrivateKey_Click"/>
                            <TextBox x:Name="PrivateKeyPathInput" FlowDirection="LeftToRight"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="۲. صدور لایسنس" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="سریال نرم‌افزار"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Content="کپی" Click="CopySoftwareSerial_Click"/>
                            <TextBox x:Name="SoftwareSerialInput" FlowDirection="LeftToRight"/>
                        </DockPanel>
                        <TextBlock Text="سریال سخت‌افزار"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Content="کپی" Click="CopyHardwareSerial_Click"/>
                            <TextBox x:Name="HardwareSerialInput" FlowDirection="LeftToRight"/>
                        </DockPanel>
                        <TextBlock Text="نام مشتری"/>
                        <TextBox x:Name="CustomerNameInput"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="تاریخ انقضا (yyyy-MM-dd)"/>
                                <TextBox x:Name="ExpiryDateInput" FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="حداکثر شعبه"/>
                                <TextBox x:Name="MaxBranchesInput" Text="1" FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="حداکثر کاربر"/>
                                <TextBox x:Name="MaxUsersInput" Text="5" FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="ماژول‌ها (با کاما جدا شوند)"/>
                        <TextBox x:Name="ModulesInput" Text="Core,Accounting,Inventory,POS,Storefront" FlowDirection="LeftToRight"/>
                        <TextBlock Text="مسیر فایل لایسنس خروجی"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Content="ذخیره به‌عنوان…" Click="BrowseLicenseOutput_Click"/>
                            <TextBox x:Name="LicenseOutputPathInput" FlowDirection="LeftToRight"/>
                        </DockPanel>
                        <Button Content="صدور لایسنس امضاشده" HorizontalAlignment="Right" Click="IssueLicense_Click" Background="#0F766E" Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="۳. بررسی لایسنس" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="مسیر فایل license.json را در قسمت مسیر خروجی انتخاب کنید یا آن را در کادر زیر وارد کنید." TextWrapping="Wrap" Foreground="#475569"/>
                        <TextBox x:Name="LicenseToVerifyPathInput" FlowDirection="LeftToRight"/>
                        <Button Content="انتخاب فایل برای بررسی…" HorizontalAlignment="Right" Click="BrowseLicenseVerify_Click"/>
                        <Button Content="بررسی امضا، سریال و انقضا" HorizontalAlignment="Right" Click="VerifyLicense_Click"/>
                    </StackPanel>
                </Border>

                <Border Background="#E2E8F0" CornerRadius="10" Padding="14">
                    <TextBlock x:Name="StatusText" Text="آماده." TextWrapping="Wrap" Foreground="#0F172A" FontSize="14"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
