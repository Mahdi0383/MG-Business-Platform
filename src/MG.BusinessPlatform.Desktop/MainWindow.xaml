<Window x:Class="MG.BusinessPlatform.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MG Business Platform" Height="780" Width="1180" MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" Background="#F3F5F9">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#17243B" Padding="22">
            <StackPanel>
                <TextBlock Text="MG Business Platform" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="مدیریت فروشگاه، محصولات و سفارش‌های آنلاین" Foreground="#D5DDEA" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom" Background="White">
            <TextBlock x:Name="StatusText" Text="در حال آماده‌سازی…" />
        </StatusBar>
        <TabControl x:Name="MainTabs" Margin="14">
            <TabItem Header="نمای کلی">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="وضعیت سامانه" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <UniformGrid Columns="3" Rows="1">
                            <Border Background="White" CornerRadius="12" Padding="18" Margin="5">
                                <StackPanel><TextBlock Text="محصولات فعال" Foreground="#64748B"/><TextBlock x:Name="ProductCountText" Text="۰" FontSize="30" FontWeight="Bold" Margin="0,8"/></StackPanel>
                            </Border>
                            <Border Background="White" CornerRadius="12" Padding="18" Margin="5">
                                <StackPanel><TextBlock Text="سفارش‌های ثبت‌شده" Foreground="#64748B"/><TextBlock x:Name="OrderCountText" Text="۰" FontSize="30" FontWeight="Bold" Margin="0,8"/></StackPanel>
                            </Border>
                            <Border Background="White" CornerRadius="12" Padding="18" Margin="5">
                                <StackPanel><TextBlock Text="سرویس وب مشتریان" Foreground="#64748B"/><TextBlock x:Name="ServerStatusText" Text="متوقف" FontSize="24" FontWeight="Bold" Margin="0,8"/><StackPanel Orientation="Horizontal"><Button x:Name="StartServerButton" Content="راه‌اندازی وب" Click="StartServer_Click"/><Button x:Name="StopServerButton" Content="توقف وب" Click="StopServer_Click"/></StackPanel></StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Background="White" CornerRadius="12" Padding="18" Margin="5,15,5,5">
                            <StackPanel>
                                <TextBlock Text="نشانی فروشگاه" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock x:Name="StoreUrlText" Text="http://127.0.0.1:8080" Margin="0,8" FontSize="15"/>
                                <TextBlock Text="این رایانه میزبان فروشگاه آنلاین است. برنامه DNS و IP عمومی را بررسی می‌کند و Caddy گواهی HTTPS را خودکار دریافت و تمدید می‌کند؛ تنظیم DNS در پنل دامنه و انتقال درگاه روتر در صورت نیاز باید انجام شود." TextWrapping="Wrap" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="محصولات">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="SkuInput" Grid.Column="0" ToolTip="کد کالا" />
                            <TextBox x:Name="NameInput" Grid.Column="1" ToolTip="نام محصول"/>
                            <TextBox x:Name="PriceInput" Grid.Column="2" ToolTip="قیمت فروش"/>
                            <TextBox x:Name="UnitCostInput" Grid.Column="3" ToolTip="بهای واحد"/>
                            <TextBox x:Name="StockInput" Grid.Column="4" ToolTip="موجودی"/>
                            <CheckBox x:Name="ProductAvailableInput" Grid.Column="5" Content="فعال" IsChecked="True" VerticalAlignment="Center" Margin="6,0"/>
                            <Button Grid.Column="6" Content="افزودن محصول" Click="AddProduct_Click"/>
                            <Button Grid.Column="7" Content="ذخیره تغییرات کالا" Click="UpdateSelectedProduct_Click"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="StockAdjustmentInput" Grid.Column="0" ToolTip="تغییر موجودی با علامت + یا -"/>
                            <TextBox x:Name="StockAdjustmentNoteInput" Grid.Column="1" ToolTip="علت اصلاح موجودی"/>
                            <Button Grid.Column="2" Content="اعمال اصلاح موجودی برای کالای انتخاب‌شده" Click="AdjustStock_Click"/>
                        </Grid>
                    </Border>
                    <DataGrid x:Name="ProductsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Background="White" SelectionChanged="ProductsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="کد کالا" Binding="{Binding Sku}" Width="1.1*"/>
                            <DataGridTextColumn Header="نام محصول" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="قیمت فروش" Binding="{Binding UnitPrice}" Width="*"/>
                            <DataGridTextColumn Header="بهای واحد" Binding="{Binding UnitCost}" Width="*"/>
                            <DataGridTextColumn Header="واحد پول" Binding="{Binding CurrencyCode}" Width="*"/>
                            <DataGridTextColumn Header="موجودی" Binding="{Binding StockQuantity}" Width="*"/>
                            <DataGridCheckBoxColumn Header="فعال" Binding="{Binding IsAvailable}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="گردش انبار">
                <DataGrid x:Name="StockMovementsGrid" Margin="12" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="زمان" Binding="{Binding OccurredAt}" Width="1.6*"/>
                        <DataGridTextColumn Header="کد کالا" Binding="{Binding ProductSku}" Width="*"/>
                        <DataGridTextColumn Header="نام کالا" Binding="{Binding ProductName}" Width="1.5*"/>
                        <DataGridTextColumn Header="نوع گردش" Binding="{Binding MovementType}" Width="1.4*"/>
                        <DataGridTextColumn Header="تغییر تعداد" Binding="{Binding SignedQuantity}" Width="*"/>
                        <DataGridTextColumn Header="بهای واحد" Binding="{Binding UnitCost}" Width="*"/>
                        <DataGridTextColumn Header="واحد پول" Binding="{Binding CurrencyCode}" Width="*"/>
                        <DataGridTextColumn Header="مرجع" Binding="{Binding Reference}" Width="1.3*"/>
                        <DataGridTextColumn Header="یادداشت" Binding="{Binding Note}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="مشتریان">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="CustomerNameInput" Grid.Column="0" ToolTip="نام مشتری"/>
                            <TextBox x:Name="CustomerPhoneInput" Grid.Column="1" ToolTip="شماره تماس"/>
                            <TextBox x:Name="CustomerEmailInput" Grid.Column="2" ToolTip="ایمیل (اختیاری)"/>
                            <TextBox x:Name="CustomerAddressInput" Grid.Column="3" ToolTip="نشانی (اختیاری)"/>
                            <Button Grid.Column="4" Content="ثبت مشتری" Click="AddCustomer_Click"/>
                        </Grid>
                    </Border>
                    <DataGrid x:Name="CustomersGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نام مشتری" Binding="{Binding DisplayName}" Width="2*"/>
                            <DataGridTextColumn Header="شماره تماس" Binding="{Binding Phone}" Width="*"/>
                            <DataGridTextColumn Header="ایمیل" Binding="{Binding Email}" Width="2*"/>
                            <DataGridTextColumn Header="نشانی" Binding="{Binding Address}" Width="3*"/>
                            <DataGridCheckBoxColumn Header="فعال" Binding="{Binding IsActive}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="تأمین‌کنندگان">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="SupplierNameInput" Grid.Column="0" ToolTip="نام تأمین‌کننده"/>
                            <TextBox x:Name="SupplierPhoneInput" Grid.Column="1" ToolTip="شماره تماس"/>
                            <TextBox x:Name="SupplierEmailInput" Grid.Column="2" ToolTip="ایمیل (اختیاری)"/>
                            <TextBox x:Name="SupplierTaxInput" Grid.Column="3" ToolTip="شناسه مالیاتی (اختیاری)"/>
                            <TextBox x:Name="SupplierTermsInput" Grid.Column="4" ToolTip="شرایط پرداخت (اختیاری)"/>
                            <Button Grid.Column="5" Content="ثبت تأمین‌کننده" Click="AddSupplier_Click"/>
                        </Grid>
                    </Border>
                    <DataGrid x:Name="SuppliersGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نام تأمین‌کننده" Binding="{Binding DisplayName}" Width="2*"/>
                            <DataGridTextColumn Header="شماره تماس" Binding="{Binding Phone}" Width="*"/>
                            <DataGridTextColumn Header="ایمیل" Binding="{Binding Email}" Width="2*"/>
                            <DataGridTextColumn Header="شناسه مالیاتی" Binding="{Binding TaxIdentifier}" Width="*"/>
                            <DataGridTextColumn Header="شرایط پرداخت" Binding="{Binding PaymentTerms}" Width="2*"/>
                            <DataGridCheckBoxColumn Header="فعال" Binding="{Binding IsActive}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="فروش حضوری (POS)">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="فروش حضوری" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <ComboBox x:Name="PosProductInput" Width="260" Margin="4" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="PosProductInput_SelectionChanged" ToolTip="انتخاب کالا"/>
                                <TextBox x:Name="PosQuantityInput" Width="90" Margin="4" Text="1" ToolTip="تعداد"/>
                                <TextBox x:Name="PosCustomerNameInput" Width="180" Margin="4" Text="مشتری حضوری" ToolTip="نام مشتری (اختیاری)"/>
                                <TextBox x:Name="PosCustomerPhoneInput" Width="140" Margin="4" ToolTip="شماره تماس (اختیاری)"/>
                                <ComboBox x:Name="PosPaymentMethodInput" Width="140" Margin="4" SelectedIndex="0">
                                    <ComboBoxItem Content="نقدی" Tag="Cash"/>
                                    <ComboBoxItem Content="کارت‌خوان" Tag="Card"/>
                                    <ComboBoxItem Content="واریز بانکی" Tag="Bank"/>
                                </ComboBox>
                                <TextBlock x:Name="PosProductInfoText" VerticalAlignment="Center" Margin="8,0" Text="کالا و تعداد را انتخاب کنید."/>
                            </WrapPanel>
                            <Button Content="ثبت فروش، صدور فاکتور و ثبت دریافت" HorizontalAlignment="Right" Click="CompletePosSale_Click"/>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="PosRecentInvoicesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="فاکتور" Binding="{Binding InvoiceNumber}" Width="1.5*"/>
                            <DataGridTextColumn Header="مشتری" Binding="{Binding CustomerName}" Width="2*"/>
                            <DataGridTextColumn Header="مبلغ" Binding="{Binding TotalAmount}" Width="*"/>
                            <DataGridTextColumn Header="پرداخت‌شده" Binding="{Binding PaidAmount}" Width="*"/>
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="فاکتورهای فروش">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="PaymentAmountInput" Width="140" ToolTip="مبلغ دریافتی"/>
                            <ComboBox x:Name="PaymentMethodInput" Width="150" SelectedIndex="0">
                                <ComboBoxItem Content="نقدی" Tag="Cash"/>
                                <ComboBoxItem Content="کارت‌خوان" Tag="Card"/>
                                <ComboBoxItem Content="واریز بانکی" Tag="Bank"/>
                            </ComboBox>
                            <TextBox x:Name="PaymentReferenceInput" Width="180" ToolTip="شماره پیگیری (اختیاری)"/>
                            <TextBox x:Name="PaymentNotesInput" Width="220" ToolTip="توضیحات (اختیاری)"/>
                            <Button Content="ثبت دریافت وجه فاکتور انتخاب‌شده" Click="RecordPayment_Click"/>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="InvoicesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="شماره فاکتور" Binding="{Binding InvoiceNumber}" Width="1.6*"/>
                            <DataGridTextColumn Header="مشتری" Binding="{Binding CustomerName}" Width="2*"/>
                            <DataGridTextColumn Header="تاریخ" Binding="{Binding IssueDate}" Width="*"/>
                            <DataGridTextColumn Header="جمع فاکتور" Binding="{Binding TotalAmount}" Width="*"/>
                            <DataGridTextColumn Header="پرداخت‌شده" Binding="{Binding PaidAmount}" Width="*"/>
                            <DataGridTextColumn Header="مانده" Binding="{Binding OutstandingAmount}" Width="*"/>
                            <DataGridTextColumn Header="واحد پول" Binding="{Binding CurrencyCode}" Width="*"/>
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="تراز آزمایشی">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <DatePicker x:Name="TrialBalanceDateInput" Width="160"/>
                            <Button Content="محاسبه تراز آزمایشی" Click="RefreshTrialBalance_Click"/>
                            <TextBlock x:Name="TrialBalanceTotalsText" VerticalAlignment="Center" Margin="12,0,0,0" Text="تراز هنوز محاسبه نشده است."/>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="TrialBalanceGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="کد حساب" Binding="{Binding AccountCode}" Width="*"/>
                            <DataGridTextColumn Header="نام حساب" Binding="{Binding AccountName}" Width="2*"/>
                            <DataGridTextColumn Header="نوع حساب" Binding="{Binding AccountType}" Width="*"/>
                            <DataGridTextColumn Header="گردش بدهکار" Binding="{Binding DebitTurnover}" Width="*"/>
                            <DataGridTextColumn Header="گردش بستانکار" Binding="{Binding CreditTurnover}" Width="*"/>
                            <DataGridTextColumn Header="مانده بدهکار" Binding="{Binding DebitBalance}" Width="*"/>
                            <DataGridTextColumn Header="مانده بستانکار" Binding="{Binding CreditBalance}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="صورت‌های مالی">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="از تاریخ" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="FinancialFromDateInput" Width="150" Margin="0,0,12,0"/>
                            <TextBlock Text="تا تاریخ" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="FinancialToDateInput" Width="150" Margin="0,0,12,0"/>
                            <Button Content="محاسبه صورت‌های مالی" Click="CalculateFinancialStatements_Click"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="FinancialStatementTotalsText" Grid.Row="1" Text="صورت‌های مالی هنوز محاسبه نشده‌اند." TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <DataGrid x:Name="FinancialStatementsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="صورت" Binding="{Binding Statement}" Width="1.2*"/>
                            <DataGridTextColumn Header="کد حساب" Binding="{Binding AccountCode}" Width="*"/>
                            <DataGridTextColumn Header="حساب" Binding="{Binding AccountName}" Width="2*"/>
                            <DataGridTextColumn Header="نوع" Binding="{Binding AccountType}" Width="*"/>
                            <DataGridTextColumn Header="مبلغ" Binding="{Binding Balance}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="سفارش‌های آنلاین">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="ثبت تحویل سفارش انتخاب‌شده" Click="FulfillOrder_Click"/>
                        <Button Content="لغو سفارش انتخاب‌شده و بازگردانی موجودی" Click="CancelOrder_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="OrdersGrid" Grid.Row="1" Margin="0,8,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="شماره سفارش" Binding="{Binding OrderNumber}" Width="1.5*"/>
                        <DataGridTextColumn Header="نام مشتری" Binding="{Binding CustomerName}" Width="1.5*"/>
                        <DataGridTextColumn Header="تماس" Binding="{Binding CustomerPhone}" Width="1.2*"/>
                        <DataGridTextColumn Header="مبلغ کل" Binding="{Binding TotalAmount}" Width="*"/>
                        <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="*"/>
                        <DataGridTextColumn Header="زمان ثبت" Binding="{Binding CreatedAt}" Width="1.6*"/>
                    </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="تنظیمات فروشگاه">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Background="White" CornerRadius="12" Padding="24" Margin="14" MaxWidth="760" HorizontalAlignment="Right">
                        <StackPanel>
                            <TextBlock Text="مشخصات فروشگاه" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/>
                            <Separator Margin="0,4,0,8"/>
                            <TextBlock Text="وضعیت فعال‌سازی" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LicenseStatusText" Text="در حال بررسی لایسنس..." TextWrapping="Wrap" Margin="4,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="سریال نرم‌افزار:" VerticalAlignment="Center" Width="120"/>
                                <TextBox x:Name="SoftwareSerialText" IsReadOnly="True" Width="390"/>
                                <Button Content="کپی" Click="CopySoftwareSerial_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                                <TextBlock Text="سریال سخت‌افزار:" VerticalAlignment="Center" Width="120"/>
                                <TextBox x:Name="HardwareSerialText" IsReadOnly="True" Width="390"/>
                                <Button Content="کپی" Click="CopyHardwareSerial_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="وارد کردن کلید عمومی" Click="ImportLicensePublicKey_Click"/>
                                <Button Content="وارد کردن فایل لایسنس" Click="ImportLicenseFile_Click"/>
                                <Button Content="بررسی مجدد لایسنس" Click="RefreshLicenseStatus_Click"/>
                            </StackPanel>
                            <TextBlock Text="برای فعال‌سازی آفلاین، کلید عمومی و فایل لایسنس امضاشده را با دکمه‌های بالا وارد کنید. کلید خصوصی صدور لایسنس را هرگز در رایانه مشتری یا داخل برنامه قرار ندهید." TextWrapping="Wrap" Foreground="#9A3412" Margin="4,8,4,12"/>
                            <TextBlock Text="نام فروشگاه"/>
                            <TextBox x:Name="StoreNameInput"/>
                            <TextBlock Text="واحد پول (کد سه‌حرفی، مانند IRR یا USD)"/>
                            <TextBox x:Name="CurrencyInput"/>
                            <TextBlock Text="دامنه مشتریان (نام میزبان بدون https://، مانند shop.example.com)"/>
                            <TextBox x:Name="HostnameInput"/>
                            <CheckBox x:Name="OnlineOrdersInput" Content="فعال‌سازی ثبت سفارش آنلاین" Margin="8,12"/>
                            <Button Content="ذخیره تنظیمات" HorizontalAlignment="Right" Click="SaveSettings_Click"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="ایجاد پشتیبان پایگاه داده" Click="CreateBackup_Click"/>
                                <Button Content="بازیابی پشتیبان" Click="RestoreBackup_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="عیب‌یابی دامنه و شبکه" Click="DiagnosePublicHosting_Click"/>
                                <Button Content="راه‌اندازی انتشار HTTPS عمومی" Click="StartPublicHosting_Click"/>
                                <Button Content="بررسی دسترسی HTTPS" Click="CheckPublicHosting_Click"/>
                                <Button Content="توقف انتشار عمومی" Click="StopPublicHosting_Click"/>
                                <Button Content="تنظیم فایروال ویندوز" Click="ConfigureFirewall_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="PublicHostingStatusText" Text="انتشار عمومی راه‌اندازی نشده است." TextWrapping="Wrap" Margin="4,8" Foreground="#334155"/>
                            <TextBlock Text="برای HTTPS عمومی، دامنه باید به IP عمومی این رایانه/روتر اشاره کند و TCP 80 و 443 باید از اینترنت به این رایانه هدایت شوند. Caddy گواهی معتبر را خودکار دریافت و تمدید می‌کند؛ شبکه‌های CGNAT یا محدودکننده ممکن است به تونل خروجی نیاز داشته باشند." TextWrapping="Wrap" Foreground="#9A3412" Margin="4,12"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="جلسات بازی">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="GameSessionNameInput" Grid.Column="0" Margin="4" ToolTip="نام بازی"/>
                            <TextBox x:Name="GameSessionRateInput" Grid.Column="1" Margin="4" Text="600000" ToolTip="نرخ ساعتی هر بازیکن (ریال)"/>
                            <Button Grid.Column="2" Margin="4" Content="افزودن بازیکن" Click="AddSessionPlayer_Click"/>
                            <Button Grid.Column="3" Margin="4" Content="شروع جلسه" Click="StartGameSession_Click"/>
                        </Grid>
                    </Border>
                    <DataGrid x:Name="SessionPlayersGrid" Grid.Row="1" Margin="0,0,0,10" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نام بازیکن" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                            <DataGridTextColumn Header="ورودی" Binding="{Binding EntryAmount, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="هزینه زمان" Binding="{Binding TimeCharge, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="هزینه اضافی" Binding="{Binding AdditionalAmount, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="مبلغ نهایی" Binding="{Binding FinalAmount, Mode=OneWay, StringFormat=N0}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="توقف موقت" Click="PauseGameSession_Click" Margin="3"/>
                        <Button Content="ادامه جلسه" Click="ResumeGameSession_Click" Margin="3"/>
                        <Button Content="پایان جلسه" Click="CompleteGameSession_Click" Margin="3"/>
                        <Button Content="به‌روزرسانی" Click="RefreshGameSessions_Click" Margin="3"/>
                    </StackPanel>
                    <DataGrid x:Name="GameSessionsGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="بازی" Binding="{Binding GameName}" Width="1.5*"/>
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="*"/>
                            <DataGridTextColumn Header="شروع" Binding="{Binding StartedAtText}" Width="1.5*"/>
                            <DataGridTextColumn Header="بازیکنان" Binding="{Binding PlayerNames}" Width="2*"/>
                            <DataGridTextColumn Header="زمان (دقیقه)" Binding="{Binding ElapsedMinutes}" Width="*"/>
                            <DataGridTextColumn Header="هزینه زمان هر نفر" Binding="{Binding PerPlayerTimeCharge, StringFormat=N0}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="GameSessionStatusText" Grid.Row="4" Margin="4,10" Text="جلسه بازی فعالی ثبت نشده است." TextWrapping="Wrap" Foreground="#334155"/>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
